---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { getCollection } from 'astro:content';

const tracks = await getCollection('tracks');
---

<Layout title="Demoer">
	<article class="mx-auto max-w-3xl px-6 py-16">
		<h1 class="font-body text-4xl font-normal uppercase tracking-[0.12em] text-gold sm:text-5xl">Demoer</h1>
		<ul id="track-list" class="mt-10 space-y-4">
			{
				tracks.map((track, i) => (
					<li
						class="track-item flex items-center gap-4 rounded-sm border border-line bg-elevated p-4 transition-colors"
						data-track
						data-src={track.data.src}
						data-index={i}
					>
						<button
							type="button"
							class="track-play flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-gold text-gold transition-colors hover:border-gold-soft hover:text-gold-soft"
							aria-label={`Spill av ${track.data.title}`}
						>
							<span data-icon="play"><Icon name="play" class="h-4 w-4" /></span>
							<span data-icon="pause" class="hidden"><Icon name="pause" class="h-4 w-4" /></span>
						</button>
						<div class="min-w-0 flex-1">
							<div class="flex items-baseline justify-between gap-3">
								<p class="truncate font-body text-sm font-semibold uppercase tracking-wide text-ivory">{track.data.title}</p>
								<p class="track-time shrink-0 font-body text-xs tabular-nums text-warm-grey">0:00</p>
							</div>
							<div class="mt-2 h-1 w-full overflow-hidden rounded-full bg-line">
								<div class="track-progress h-full w-0 rounded-full bg-gold"></div>
							</div>
						</div>
					</li>
				))
			}
		</ul>
		<audio id="demo-audio" preload="none"></audio>
	</article>
</Layout>

<script>
	const audio = document.getElementById('demo-audio') as HTMLAudioElement | null;
	const items = Array.from(document.querySelectorAll<HTMLLIElement>('[data-track]'));

	function formatTime(seconds: number) {
		if (!Number.isFinite(seconds)) return '0:00';
		const m = Math.floor(seconds / 60);
		const s = Math.floor(seconds % 60)
			.toString()
			.padStart(2, '0');
		return `${m}:${s}`;
	}

	function resetItem(item: HTMLLIElement) {
		item.querySelector('[data-icon="play"]')?.classList.remove('hidden');
		item.querySelector('[data-icon="pause"]')?.classList.add('hidden');
		const progress = item.querySelector<HTMLElement>('.track-progress');
		if (progress) progress.style.width = '0%';
		const time = item.querySelector('.track-time');
		if (time) time.textContent = '0:00';
		item.classList.remove('border-gold');
	}

	if (audio) {
		let active: HTMLLIElement | null = null;

		items.forEach((item) => {
			const button = item.querySelector('.track-play');
			button?.addEventListener('click', () => {
				const src = item.dataset.src ?? '';
				if (active === item && !audio.paused) {
					audio.pause();
					return;
				}
				if (active !== item) {
					if (active) resetItem(active);
					active = item;
					audio.src = src;
				}
				audio.play();
			});
		});

		audio.addEventListener('play', () => {
			if (!active) return;
			active.querySelector('[data-icon="play"]')?.classList.add('hidden');
			active.querySelector('[data-icon="pause"]')?.classList.remove('hidden');
			active.classList.add('border-gold');
		});

		audio.addEventListener('pause', () => {
			if (!active) return;
			active.querySelector('[data-icon="play"]')?.classList.remove('hidden');
			active.querySelector('[data-icon="pause"]')?.classList.add('hidden');
		});

		audio.addEventListener('timeupdate', () => {
			if (!active || !audio.duration) return;
			const progress = active.querySelector<HTMLElement>('.track-progress');
			if (progress) progress.style.width = `${(audio.currentTime / audio.duration) * 100}%`;
			const time = active.querySelector('.track-time');
			if (time) time.textContent = formatTime(audio.duration - audio.currentTime);
		});

		audio.addEventListener('ended', () => {
			if (active) resetItem(active);
			active = null;
		});
	}
</script>
