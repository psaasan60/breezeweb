---
import Layout from '../layouts/Layout.astro';
import { getEntry } from 'astro:content';

const entry = await getEntry('pages', 'press');
const images = entry.data.images ?? [];
---

<Layout title={entry.data.title}>
	<article class="mx-auto max-w-3xl px-6 py-16">
		<h1 class="font-display text-4xl uppercase tracking-wide text-gold sm:text-5xl">{entry.data.title}</h1>
		{
			images.length > 0 && (
				<div class="mt-10 grid gap-4 sm:grid-cols-2">
					{images.map((src) => (
						<a href={src} target="_blank" rel="noreferrer" class="block overflow-hidden rounded-sm border border-line">
							<img src={src} alt="Pressebilde – The Breeze" class="h-full w-full object-cover" />
						</a>
					))}
				</div>
			)
		}
	</article>
</Layout>
