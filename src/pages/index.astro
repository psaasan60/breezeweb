---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import FramedImage from '../components/FramedImage.astro';
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import heroImage from '../assets/images/hero-forside.png';

const today = new Date().toISOString().slice(0, 10);
const upcoming = (await getCollection('concerts'))
	.filter((c) => c.data.date >= today)
	.sort((a, b) => a.data.date.localeCompare(b.data.date))
	.slice(0, 3);

const formatter = new Intl.DateTimeFormat('nb-NO', { day: 'numeric', month: 'long', year: 'numeric' });

const band = await getEntry('pages', 'band');
const testimonials = band?.data.testimonials ?? [];
const members = band?.data.members ?? [];
const jjCale = await getEntry('pages', 'jj-cale');

const backstagePosts = (await getCollection('backstage'))
	.sort((a, b) => b.data.date.localeCompare(a.data.date))
	.slice(0, 1);
---

<Layout>
	<section class="relative flex min-h-[80vh] flex-col items-center justify-start gap-4 overflow-hidden px-6 pt-8 pb-10 text-center">
		<Image
			src={heroImage}
			alt=""
			class="absolute inset-0 -z-10 h-full w-full object-cover object-top brightness-125"
			widths={[640, 1024, 1600, 2000]}
			sizes="100vw"
			format="webp"
			quality={75}
			loading="eager"
			fetchpriority="high"
		/>
		<div class="absolute inset-0 -z-10 bg-linear-to-t from-base/70 via-base/25 to-base/0"></div>

		<h1 class="relative w-full">
			<img
				src="/logo/logo-arc-wordmark-only-light.svg"
				alt="The Breeze"
				class="mx-auto block w-full max-w-208 drop-shadow-[0_4px_18px_rgba(0,0,0,0.65)]"
			/>
		</h1>
		<p class="absolute bottom-[18%] left-0 w-full font-body text-[1.2rem] font-bold uppercase tracking-[0.6em] text-gold-soft drop-shadow-[0_2px_8px_rgba(0,0,0,0.75)]">
			A tribute to J.J. Cale and The Tulsa sound
		</p>
	</section>

	<div class="border-b border-line bg-elevated px-6 py-10 text-center">
		<p class="font-body text-xs font-bold uppercase tracking-[0.16em] text-warm-grey-dim">Lytt til oss</p>
		<button
			id="listen-play-button"
			type="button"
			data-src="/audio/Medley.mp3"
			class="mt-4 inline-flex items-center gap-3 rounded-sm border-2 border-gold px-8 py-4 font-body text-base font-bold uppercase tracking-wider text-gold transition-colors hover:border-gold-soft hover:text-gold-soft"
		>
			<span data-icon="play"><Icon name="play" class="h-6 w-6" /></span>
			<span data-icon="pause" class="hidden"><Icon name="pause" class="h-6 w-6" /></span>
			The Breeze medley
		</button>
		<audio id="listen-audio" preload="none"></audio>
		<p class="mt-4">
			<a href="/demoer/" class="font-body text-xs uppercase tracking-wide text-warm-grey underline-offset-4 hover:text-gold hover:underline">
				Se alle demoer
			</a>
		</p>
	</div>

	{
		band?.data.excerpt && (
			<section class="mx-auto max-w-5xl px-6 py-16 sm:py-20">
				<div class="grid items-center gap-10 sm:grid-cols-[1.1fr_0.9fr] sm:gap-12">
					<div>
						<h2 class="font-body text-2xl font-normal uppercase tracking-widest text-gold sm:text-3xl">
							The Breeze – The Tulsa sound lever videre
						</h2>
						<p class="mt-5 font-body leading-relaxed text-warm-grey">{band.data.excerpt}</p>
						<a
							href="/band/"
							class="mt-6 inline-block rounded-sm border border-gold px-6 py-3 font-body text-sm font-bold uppercase tracking-wider text-gold transition-colors hover:border-gold-soft hover:text-gold-soft"
						>
							Les mer om bandet
						</a>
					</div>
					{jjCale?.data.image && (
						<div class="border border-line">
							<img src={jjCale.data.image} alt="JJ Cale" class="aspect-4/3 w-full object-cover grayscale contrast-105" />
						</div>
					)}
				</div>
			</section>
		)
	}

	{
		upcoming.length > 0 && (
			<section class="mx-auto max-w-5xl px-6 pt-4 pb-24">
				<div class="grid gap-8 sm:grid-cols-3">
					{upcoming.map((c) => {
						const Card = c.data.url ? 'a' : 'div';
						const linkProps = c.data.url ? { href: c.data.url, target: '_blank', rel: 'noreferrer' } : {};
						return (
							<Card
								{...linkProps}
								class="group block overflow-hidden rounded-sm border border-line bg-elevated text-left transition-colors hover:border-gold"
							>
								<FramedImage
									src={c.data.image}
									alt={c.data.venue}
									size="sm"
									class="aspect-4/3"
									imgClass="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
								>
									<div class="flex aspect-4/3 w-full flex-col items-center justify-center gap-2 text-warm-grey-dim">
										<Icon name="photo" class="h-6 w-6" />
										<span class="font-body text-[0.65rem] uppercase tracking-wide">Bilde kommer</span>
									</div>
								</FramedImage>
								<div class="p-4">
									<p class="font-body font-bold text-ivory">{c.data.venue}</p>
									<p class="mt-1 font-body text-sm uppercase tracking-wide text-warm-grey">
										{formatter.format(new Date(c.data.date))}
										{c.data.time && ` · ${c.data.time}`}
									</p>
								</div>
							</Card>
						);
					})}
				</div>
			</section>
		)
	}

	{
		members.length > 0 && (
			<section class="mx-auto max-w-7xl px-6 pb-24">
				<div class="rounded-sm border border-line bg-elevated p-8 sm:p-14">
					<h2 class="text-center font-body text-3xl font-normal uppercase tracking-[0.12em] text-gold sm:text-4xl">Møt bandet</h2>
					<div class="mt-8 grid grid-cols-2 gap-8 sm:grid-cols-5">
						{members.map((m) => (
							<div>
								<FramedImage
									src={m.image}
									alt={m.name}
									size="sm"
									class="aspect-3/4"
									imgClass="h-full w-full object-cover"
								>
									<div class="flex aspect-3/4 w-full flex-col items-center justify-center gap-2 text-warm-grey-dim">
										<Icon name="photo" class="h-6 w-6" />
										<span class="font-body text-[0.6rem] uppercase tracking-wide">Bilde kommer</span>
									</div>
								</FramedImage>
								<p class="mt-3 text-center font-body text-sm font-bold uppercase tracking-wide text-ivory">{m.name}</p>
								<p class="text-center font-body text-xs uppercase tracking-wide text-warm-grey">{m.role}</p>
							</div>
						))}
					</div>
				</div>
			</section>
		)
	}

	{
		backstagePosts.length > 0 && (
			<section class="border-b border-line bg-elevated px-6 py-12 sm:py-16">
				<div class="mx-auto max-w-5xl">
					<div class="mb-6 flex items-center justify-between">
						<h2 class="font-body text-xl font-normal uppercase tracking-[0.12em] text-gold sm:text-2xl">
							Fra Backstage
						</h2>
						<a href="/backstage/" class="font-body text-xs font-bold uppercase tracking-wide text-gold hover:text-gold-soft">
							Se alle
						</a>
					</div>
					<!-- Kompakt teaser -->
					<a href={`/backstage/${backstagePosts[0].id}/`} class="group grid gap-4 overflow-hidden rounded-sm border border-line bg-base transition-colors hover:border-gold sm:grid-cols-[0.6fr_1fr]">
						<div class="relative aspect-video h-40 overflow-hidden bg-charcoal sm:h-full">
							<img
								src={backstagePosts[0].data.image}
								alt={backstagePosts[0].data.title}
								class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
								loading="lazy"
							/>
						</div>
						<div class="flex flex-col justify-between p-4 sm:p-5">
							<div>
								<time class="font-body text-xs uppercase tracking-wide text-gold-soft">
									{new Date(backstagePosts[0].data.date + 'T00:00:00').toLocaleDateString('nb-NO', { day: 'numeric', month: 'long', year: 'numeric' })}
								</time>
								<h3 class="mt-1 font-body text-base font-bold uppercase tracking-wide text-ivory sm:text-lg">
									{backstagePosts[0].data.title}
								</h3>
							</div>
							<p class="mt-2 font-body text-xs text-warm-grey line-clamp-2">
								{backstagePosts[0].data.excerpt}
							</p>
						</div>
					</a>
				</div>
			</section>
		)
	}

	{
		testimonials.length > 0 && (
			<section class="mx-auto max-w-3xl px-6 pb-24 text-center">
				<div id="testimonial-rotator" class="relative">
					<div class="font-serif text-6xl leading-none text-gold opacity-35" aria-hidden="true">&ldquo;</div>
					{testimonials.map((t, i) => (
						<div class:list={['testimonial-slide', { hidden: i !== 0 }]} data-index={i}>
							<p class="font-body text-2xl leading-snug text-ivory italic">&ldquo;{t.quote}&rdquo;</p>
							<p class="mt-4 font-body text-xs uppercase tracking-wide text-gold-soft">{t.author}</p>
						</div>
					))}
					<div class="mt-8 flex justify-center gap-2">
						{testimonials.map((_, i) => (
							<button
								type="button"
								class:list={['h-1.75 w-1.75 rounded-full bg-line transition-colors', { 'bg-gold': i === 0 }]}
								data-dot={i}
								aria-label={`Sitat ${i + 1}`}
							/>
						))}
					</div>
				</div>
			</section>
		)
	}

	<div class="border-t border-b border-line bg-elevated px-6 py-16 text-center">
		<h2 class="font-body text-3xl font-normal uppercase tracking-[0.12em] text-gold sm:text-4xl">Vil du booke The Breeze?</h2>
		<p class="mx-auto mt-4 max-w-xl font-body leading-relaxed text-warm-grey">
			Vi spiller på bluesklubber, private arrangementer og festivaler over hele landet. Ta kontakt for pris og tilgjengelighet.
		</p>
		<a
			href="/booking/"
			class="mt-7 inline-block rounded-sm border border-gold px-8 py-3 font-body text-sm font-bold uppercase tracking-wider text-gold transition-colors hover:border-gold-soft hover:text-gold-soft"
		>
			Kontakt for booking
		</a>
	</div>
</Layout>

<script>
	const playButton = document.getElementById('listen-play-button') as HTMLButtonElement | null;
	const audio = document.getElementById('listen-audio') as HTMLAudioElement | null;
	if (playButton && audio) {
		const playIcon = playButton.querySelector('[data-icon="play"]');
		const pauseIcon = playButton.querySelector('[data-icon="pause"]');
		audio.src = playButton.dataset.src ?? '';

		function setPlaying(playing: boolean) {
			playIcon?.classList.toggle('hidden', playing);
			pauseIcon?.classList.toggle('hidden', !playing);
		}

		playButton.addEventListener('click', () => {
			if (audio.paused) {
				audio.play();
			} else {
				audio.pause();
			}
		});
		audio.addEventListener('play', () => setPlaying(true));
		audio.addEventListener('pause', () => setPlaying(false));
		audio.addEventListener('ended', () => setPlaying(false));
	}

	const root = document.getElementById('testimonial-rotator');
	if (root) {
		const slides = Array.from(root.querySelectorAll<HTMLElement>('.testimonial-slide'));
		const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-dot]'));
		let current = 0;
		let timer: ReturnType<typeof setTimeout>;

		function readingTime(el: HTMLElement) {
			const words = (el.textContent ?? '').trim().split(/\s+/).length;
			return Math.max(6000, words * 350);
		}

		function show(next: number) {
			slides[current]?.classList.add('hidden');
			dots[current]?.classList.remove('bg-gold');
			current = next;
			slides[current]?.classList.remove('hidden');
			dots[current]?.classList.add('bg-gold');
		}

		function scheduleNext() {
			clearTimeout(timer);
			if (slides.length > 1) {
				const active = slides[current];
				timer = setTimeout(() => {
					show((current + 1) % slides.length);
					scheduleNext();
				}, active ? readingTime(active) : 6000);
			}
		}

		dots.forEach((dot, i) =>
			dot.addEventListener('click', () => {
				show(i);
				scheduleNext();
			}),
		);

		scheduleNext();
	}
</script>
