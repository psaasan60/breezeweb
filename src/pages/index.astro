---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import FrameOrnament from '../components/FrameOrnament.astro';
import FramedImage from '../components/FramedImage.astro';
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import heroImage from '../assets/images/hero-forside.png';

const today = new Date().toISOString().slice(0, 10);
const upcoming = (await getCollection('concerts'))
	.filter((c) => c.data.date >= today)
	.sort((a, b) => a.data.date.localeCompare(b.data.date))
	.slice(0, 3);

const formatter = new Intl.DateTimeFormat('nb-NO', { day: 'numeric', month: 'long', year: 'numeric' });

const band = await getEntry('pages', 'band');
const testimonials = band?.data.testimonials ?? [];
const members = band?.data.members ?? [];
---

<Layout>
	<section class="relative flex min-h-[80vh] flex-col items-center justify-start gap-4 overflow-hidden px-6 pt-8 text-center">
		<Image
			src={heroImage}
			alt=""
			class="absolute inset-0 -z-10 h-full w-full object-cover object-top brightness-125"
			widths={[640, 1024, 1600, 2000]}
			sizes="100vw"
			format="webp"
			quality={75}
			loading="eager"
			fetchpriority="high"
		/>
		<div class="absolute inset-0 -z-10 bg-linear-to-t from-base/70 via-base/25 to-base/0"></div>
		<FrameOrnament inset="24px" cornerClass="h-9 w-9" diamondClass="h-2.5 w-2.5" diamondOffset="14px" />

		<h1 class="relative w-full">
			<img
				src="/logo/logo-arc-sub-light.svg"
				alt="The Breeze – A tribute to J.J. Cale & Tulsa Sound"
				class="mx-auto w-full max-w-6xl drop-shadow-[0_4px_18px_rgba(0,0,0,0.65)]"
			/>
		</h1>
	</section>

	{
		upcoming.length > 0 && (
			<section class="mx-auto max-w-5xl px-6 pt-16 pb-24">
				<div class="grid gap-8 sm:grid-cols-3">
					{upcoming.map((c) => {
						const Card = c.data.url ? 'a' : 'div';
						const linkProps = c.data.url ? { href: c.data.url, target: '_blank', rel: 'noreferrer' } : {};
						return (
							<Card
								{...linkProps}
								class="group block overflow-hidden rounded-sm border border-line bg-elevated text-left transition-colors hover:border-gold"
							>
								<FramedImage
									src={c.data.image}
									alt={c.data.venue}
									size="sm"
									class="aspect-4/3"
									imgClass="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
								>
									<div class="flex aspect-4/3 w-full flex-col items-center justify-center gap-2 text-warm-grey-dim">
										<Icon name="photo" class="h-6 w-6" />
										<span class="font-body text-[0.65rem] uppercase tracking-wide">Bilde kommer</span>
									</div>
								</FramedImage>
								<div class="p-4">
									<p class="font-body font-bold text-ivory">{c.data.venue}</p>
									<p class="mt-1 font-body text-sm uppercase tracking-wide text-warm-grey">
										{formatter.format(new Date(c.data.date))}
										{c.data.time && ` · ${c.data.time}`}
									</p>
								</div>
							</Card>
						);
					})}
				</div>
			</section>
		)
	}

	{
		testimonials.length > 0 && (
			<section class="mx-auto max-w-5xl px-6 pb-24">
				<div class="rounded-sm border border-line bg-elevated p-8 sm:p-10">
					<h2 class="text-center font-body text-3xl font-normal uppercase tracking-[0.12em] text-gold sm:text-4xl">Hva sier arrangørene?</h2>
					<div class="mt-8 grid gap-8 sm:grid-cols-2">
						{testimonials.map((t) => (
							<blockquote class="border-l-2 border-gold pl-4">
								<p class="font-body text-warm-grey italic">&ldquo;{t.quote}&rdquo;</p>
								<footer class="mt-2 font-body text-sm uppercase tracking-wide text-gold-soft">{t.author}</footer>
							</blockquote>
						))}
					</div>
				</div>
			</section>
		)
	}

	{
		members.length > 0 && (
			<section class="mx-auto max-w-7xl px-6 pb-24">
				<div class="rounded-sm border border-line bg-elevated p-8 sm:p-14">
					<h2 class="text-center font-body text-3xl font-normal uppercase tracking-[0.12em] text-gold sm:text-4xl">Møt bandet</h2>
					<div class="mt-8 grid grid-cols-2 gap-8 sm:grid-cols-5">
						{members.map((m) => (
							<div>
								<FramedImage
									src={m.image}
									alt={m.name}
									size="sm"
									class="aspect-3/4"
									imgClass="h-full w-full object-cover"
								>
									<div class="flex aspect-3/4 w-full flex-col items-center justify-center gap-2 text-warm-grey-dim">
										<Icon name="photo" class="h-6 w-6" />
										<span class="font-body text-[0.6rem] uppercase tracking-wide">Bilde kommer</span>
									</div>
								</FramedImage>
								<p class="mt-3 text-center font-body text-sm font-bold uppercase tracking-wide text-ivory">{m.name}</p>
								<p class="text-center font-body text-xs uppercase tracking-wide text-warm-grey">{m.role}</p>
							</div>
						))}
					</div>
				</div>
			</section>
		)
	}
</Layout>
