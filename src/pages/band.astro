---
import Layout from '../layouts/Layout.astro';
import FramedImage from '../components/FramedImage.astro';
import { getEntry, render } from 'astro:content';

const entry = await getEntry('pages', 'band');
const { Content } = await render(entry);
const { members = [], testimonials = [] } = entry.data;
---

<Layout title={entry.data.title}>
	<article class="mx-auto max-w-3xl px-6 py-16">
		<h1 class="font-body text-4xl font-normal uppercase tracking-[0.12em] text-gold sm:text-5xl">{entry.data.title}</h1>
		{entry.data.image && <FramedImage src={entry.data.image} alt={entry.data.title} class="mt-8" />}
		<div class="mt-8 space-y-4 font-body text-warm-grey [&_p]:leading-relaxed">
			<Content />
		</div>

		{
			members.length > 0 && (
				<section class="mt-12">
					<h2 class="font-body text-2xl font-normal uppercase tracking-[0.12em] text-gold">Medlemmer</h2>
					<ul class="mt-4 grid gap-3 sm:grid-cols-2">
						{members.map((m) => (
							<li class="rounded-sm border border-line bg-elevated px-4 py-3">
								<details class="group">
									<summary class="flex cursor-pointer list-none items-center gap-4 marker:content-none [&::-webkit-details-marker]:hidden">
										{m.image && <img src={m.image} alt={m.name} class="h-14 w-14 shrink-0 rounded-full object-cover" />}
										<span class="min-w-0 flex-1">
											<p class="font-body font-bold text-ivory">{m.name}</p>
											<p class="font-body text-sm text-warm-grey">{m.role}</p>
										</span>
										<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-4 w-4 shrink-0 text-warm-grey transition-transform group-open:rotate-45">
											<path d="M12 4.5v15M4.5 12h15" stroke-linecap="round" />
										</svg>
									</summary>
									{m.bio && (
										<dl class="mt-3 space-y-2 font-body text-sm leading-relaxed text-warm-grey">
											{m.bio.whoAmI && <p>{m.bio.whoAmI}</p>}
											{m.bio.from && (
												<div>
													<dt class="inline text-gold-soft">Fra: </dt>
													<dd class="inline">{m.bio.from}</dd>
												</div>
											)}
											{m.bio.instruments && (
												<div>
													<dt class="inline text-gold-soft">Instrumenter: </dt>
													<dd class="inline">{m.bio.instruments}</dd>
												</div>
											)}
											{m.bio.bands && (
												<div>
													<dt class="inline text-gold-soft">Tidligere band: </dt>
													<dd class="inline">{m.bio.bands}</dd>
												</div>
											)}
											{m.bio.interests && (
												<div>
													<dt class="inline text-gold-soft">Interesser: </dt>
													<dd class="inline">{m.bio.interests}</dd>
												</div>
											)}
										</dl>
									)}
								</details>
							</li>
						))}
					</ul>
				</section>
			)
		}

		{
			testimonials.length > 0 && (
				<section class="mt-12">
					<h2 class="font-body text-2xl font-normal uppercase tracking-[0.12em] text-gold">Hva sier arrangørene?</h2>
					<ul class="mt-4 space-y-6">
						{testimonials.map((t) => (
							<li class="border-l-2 border-gold pl-4">
								<p class="font-body italic text-warm-grey">&ldquo;{t.quote}&rdquo;</p>
								<p class="mt-2 font-body text-sm uppercase tracking-wide text-gold-soft">{t.author}</p>
							</li>
						))}
					</ul>
				</section>
			)
		}
	</article>
</Layout>
