---
import Icon from './Icon.astro';
---

<footer class="border-t border-line bg-base px-6 py-10 text-center">
	<p class="font-body text-sm uppercase tracking-[0.2em] text-gold-soft">A tribute to J.J. Cale and The Tulsa sound</p>
	<div class="mt-5 flex justify-center gap-5 text-warm-grey">
		<a href="/booking/" aria-label="Kontakt The Breeze" class="transition-colors hover:text-gold">
			<Icon name="mail" class="h-5 w-5" />
		</a>
		<a
			href="https://www.facebook.com/profile.php?id=61582227454135&locale=nb_NO"
			target="_blank"
			rel="noreferrer"
			aria-label="Facebook"
			class="transition-colors hover:text-gold"
		>
			<Icon name="facebook" class="h-5 w-5" />
		</a>
		<a
			href="https://www.youtube.com/watch?v=uAdtb_BA6jY"
			target="_blank"
			rel="noreferrer"
			aria-label="YouTube"
			class="transition-colors hover:text-gold"
		>
			<Icon name="youtube" class="h-5 w-5" />
		</a>
	</div>
	<p class="mt-6 font-body text-[0.65rem] uppercase tracking-[0.15em] text-warm-grey-dim">
		&copy; {new Date().getFullYear()} The Breeze. Alle rettigheter forbeholdt.
	</p>
</footer>
