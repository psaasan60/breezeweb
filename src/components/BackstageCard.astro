---
export interface Props {
  title: string;
  excerpt: string;
  image: string;
  date: string;
  href: string;
}

const { title, excerpt, image, date, href } = Astro.props;

const formatter = new Intl.DateTimeFormat('nb-NO', { day: 'numeric', month: 'long', year: 'numeric' });
const formattedDate = formatter.format(new Date(date + 'T00:00:00'));
---

<a href={href} class="group block transition-opacity hover:opacity-80">
  <article class="overflow-hidden rounded-sm border border-line bg-elevated">
    <!-- Bildet -->
    <div class="relative aspect-video overflow-hidden bg-charcoal">
      <img
        src={image}
        alt={title}
        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
        loading="lazy"
      />
    </div>

    <!-- Innhold -->
    <div class="p-6">
      <time class="font-body text-xs uppercase tracking-wide text-gold-soft">{formattedDate}</time>
      <h3 class="mt-2 font-body text-xl font-bold uppercase tracking-wide text-ivory">
        {title}
      </h3>
      <p class="mt-3 font-body text-sm leading-relaxed text-warm-grey line-clamp-2">
        {excerpt}
      </p>
      <div class="mt-4 inline-flex items-center gap-2 font-body text-xs font-bold uppercase tracking-wide text-gold transition-colors group-hover:text-gold-soft">
        Les mer
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </div>
    </div>
  </article>
</a>
