---
const links = [
	{ href: '/jj-cale/', label: 'JJ Cale' },
	{ href: '/band/', label: 'The Breeze' },
	{ href: '/konserter/', label: 'Konsert kalender' },
	{ href: '/demoer/', label: 'Demoer' },
	{ href: '/presse/', label: 'Presse' },
	{ href: '/booking/', label: 'Booking' },
];
---

<header class="border-b border-line bg-base">
	<nav class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-4 px-6 py-5">
		<a href="/" class="font-display text-2xl uppercase tracking-wide text-ivory">The Breeze</a>
		<ul class="flex flex-wrap gap-x-6 gap-y-2 font-body text-xs uppercase tracking-[0.15em] text-warm-grey">
			{
				links.map((link) => (
					<li>
						<a href={link.href} class="transition-colors hover:text-gold">
							{link.label}
						</a>
					</li>
				))
			}
		</ul>
	</nav>
</header>
